# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client-side calls to Anthropic are for local/dev convenience only.
# For production, proxy this through a server/edge function so the key
# is never shipped to the browser.
VITE_ANTHROPIC_API_KEY=

# Google OAuth (Gmail, GA4, Search Console) — added when wiring real integrations
VITE_GOOGLE_CLIENT_ID=
